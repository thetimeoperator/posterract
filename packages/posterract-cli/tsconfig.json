{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "useDefineForClassFields": true,
    "erasableSyntaxOnly": false,
    "lib": [
      "es2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve"
  },
  "include": ["src"]
}
