{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/meta/threads/deauthorize",
      "destination": "https://handsome-dotterel-46.convex.site/meta/threads/deauthorize"
    },
    {
      "source": "/api/meta/threads/data-deletion",
      "destination": "https://handsome-dotterel-46.convex.site/meta/threads/data-deletion"
    },
    {
      "source": "/api/meta/instagram/deauthorize",
      "destination": "https://handsome-dotterel-46.convex.site/meta/instagram/deauthorize"
    },
    {
      "source": "/api/meta/instagram/data-deletion",
      "destination": "https://handsome-dotterel-46.convex.site/meta/instagram/data-deletion"
    },
    {
      "source": "/api/meta/facebook/deauthorize",
      "destination": "https://handsome-dotterel-46.convex.site/meta/facebook/deauthorize"
    },
    {
      "source": "/api/meta/facebook/data-deletion",
      "destination": "https://handsome-dotterel-46.convex.site/meta/facebook/data-deletion"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
