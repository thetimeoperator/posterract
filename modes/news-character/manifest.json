{
  "$schema": "https://vidtryx.local/schemas/mode-manifest.v1.json",
  "schemaVersion": 1,
  "modeId": "news-character",
  "displayName": "News Character Mode",
  "status": "bridge-fixture",
  "description": "Character-led vertical news video mode bridged to the desktop fake-run preview until a real runner is connected.",
  "desktop": {
    "modeId": "news-character",
    "fakePreviewEnabled": true,
    "fixtureOutputUrl": "/fixtures/news-character/news-character-fake-preview.mp4",
    "sampleOutputExport": "apps/desktop/src/lib/sampleOutput.ts#sampleOutputUrl"
  },
  "stages": [
    {
      "id": "script",
      "label": "Writing angle",
      "runnerStep": "research-and-script",
      "description": "Select one narrative, validate practical consequence, and produce the runtime script.",
      "expectedArtifacts": ["selected-topic", "runtime-script"]
    },
    {
      "id": "visual-plan",
      "label": "Designing scenes",
      "runnerStep": "hyperframes-planning",
      "description": "Break the runtime script into scene beats and produce the HyperFrames planning package.",
      "expectedArtifacts": ["hyperframes-plan"]
    },
    {
      "id": "avatar",
      "label": "Rendering character",
      "runnerStep": "heygen-render",
      "description": "Render the configured HeyGen avatar or talking photo clip for the bottom half.",
      "expectedArtifacts": ["heygen-raw-video", "heygen-render-metadata"]
    },
    {
      "id": "hyperframes",
      "label": "Building visuals",
      "runnerStep": "hyperframes-render",
      "description": "Render the top-half informational motion design from the planning package.",
      "expectedArtifacts": ["hyperframes-output", "motion-preview"]
    },
    {
      "id": "assembly",
      "label": "Assembling video",
      "runnerStep": "ffmpeg-assembly",
      "description": "Stack HyperFrames visuals over the avatar clip, add lower-third title treatment, and preserve raw assets.",
      "expectedArtifacts": ["assembled-master", "lower-third-title"]
    },
    {
      "id": "export",
      "label": "Export ready",
      "runnerStep": "final-speedup-and-package",
      "description": "Speed the completed master to 1.5x and publish the final run artifact package.",
      "expectedArtifacts": ["final-master", "run-summary"]
    }
  ],
  "providers": [
    {
      "id": "agent-runtime",
      "kind": "orchestration",
      "required": true,
      "envKeys": [],
      "responsibilities": ["topic-selection", "script-writing", "scene-planning", "runner-coordination"]
    },
    {
      "id": "heygen",
      "kind": "video",
      "required": true,
      "envKeys": ["HEYGEN_API_KEY", "HEYGEN_VOICE_ID"],
      "oneOfEnvKeys": ["HEYGEN_AVATAR_ID", "HEYGEN_TALKING_PHOTO_ID", "HEYGEN_AVATAR_LOOK_ID"],
      "configPaths": ["trending-news-character-skill copy 2/config/video.json"]
    },
    {
      "id": "hyperframes",
      "kind": "motion-design",
      "required": true,
      "envKeys": [],
      "responsibilities": ["top-half-scene-render", "motion-preview"]
    },
    {
      "id": "ffmpeg",
      "kind": "assembly",
      "required": true,
      "envKeys": [],
      "optionalEnvKeys": ["FFMPEG_PATH", "FFPROBE_PATH"],
      "responsibilities": ["vertical-stack", "lower-third-title", "final-speedup"]
    },
    {
      "id": "x",
      "kind": "research",
      "required": false,
      "enabledWhen": "config/research.json mode is x_keywords or x_list",
      "envKeys": ["X_BEARER_TOKEN"],
      "optionalEnvKeys": ["X_DAILY_POST_CAP", "X_POSTS_PER_KEYWORD_CAP", "X_MAX_API_CALLS"]
    },
    {
      "id": "elevenlabs",
      "kind": "voice-or-transcript-helper",
      "required": false,
      "enabledWhen": "voice_provider is elevenlabs or optional caption/transcript helpers are enabled",
      "envKeys": ["ELEVENLABS_API_KEY"],
      "optionalEnvKeys": ["ELEVENLABS_VOICE_ID"]
    }
  ],
  "artifacts": [
    {
      "id": "selected-topic",
      "stageId": "script",
      "type": "json",
      "required": true,
      "runnerField": "selectedTopic"
    },
    {
      "id": "runtime-script",
      "stageId": "script",
      "type": "text",
      "required": true,
      "desktopArtifactType": "script",
      "desktopLabel": "Runtime script"
    },
    {
      "id": "heygen-raw-video",
      "stageId": "avatar",
      "type": "video/mp4",
      "required": true,
      "runnerField": "rawHeygenRenderPath"
    },
    {
      "id": "hyperframes-plan",
      "stageId": "visual-plan",
      "type": "application/json",
      "required": true,
      "runnerField": "hyperframesPlanningPackagePath"
    },
    {
      "id": "hyperframes-output",
      "stageId": "hyperframes",
      "type": "directory",
      "required": true,
      "runnerField": "hyperframesAssetOutputPath"
    },
    {
      "id": "motion-preview",
      "stageId": "hyperframes",
      "type": "preview",
      "required": false,
      "desktopArtifactType": "preview",
      "desktopLabel": "Motion preview"
    },
    {
      "id": "assembled-master",
      "stageId": "assembly",
      "type": "video/mp4",
      "required": true,
      "runnerField": "assembledMasterPath"
    },
    {
      "id": "lower-third-title",
      "stageId": "assembly",
      "type": "text",
      "required": true,
      "runnerField": "lowerThirdTitlePath"
    },
    {
      "id": "final-master",
      "stageId": "export",
      "type": "video/mp4",
      "required": true,
      "desktopArtifactType": "video",
      "desktopLabel": "Final master",
      "runnerField": "outputUrl"
    },
    {
      "id": "run-summary",
      "stageId": "export",
      "type": "json",
      "required": true,
      "runnerField": "summary"
    }
  ],
  "eventMapping": {
    "clientEventSchema": "apps/desktop/src/state/types.ts#RunEvent",
    "clientEnvelopeSchema": "apps/desktop/src/state/types.ts#RunEventEnvelope",
    "runnerToClient": [
      {
        "runnerEvent": "runner.run.started",
        "clientEvent": "run.started",
        "requiredFields": ["runId", "modeId"]
      },
      {
        "runnerEvent": "runner.stage.started",
        "clientEvent": "stage.started",
        "requiredFields": ["runId", "stageId", "label", "index"]
      },
      {
        "runnerEvent": "runner.stage.progress",
        "clientEvent": "stage.progress",
        "requiredFields": ["runId", "stageId", "progress"]
      },
      {
        "runnerEvent": "runner.stage.completed",
        "clientEvent": "stage.completed",
        "requiredFields": ["runId", "stageId"]
      },
      {
        "runnerEvent": "runner.artifact.created",
        "clientEvent": "artifact.created",
        "requiredFields": ["runId", "artifactType", "label"],
        "optionalFields": ["url"]
      },
      {
        "runnerEvent": "runner.run.completed",
        "clientEvent": "run.completed",
        "requiredFields": ["runId"],
        "optionalFields": ["outputUrl"]
      },
      {
        "runnerEvent": "runner.run.failed",
        "clientEvent": "run.failed",
        "requiredFields": ["runId", "message"]
      }
    ],
    "desktopFakeRunCompatibility": {
      "script.completed": {
        "emit": "artifact.created",
        "artifactType": "script",
        "label": "Runtime script"
      },
      "hyperframes.completed": {
        "emit": "artifact.created",
        "artifactType": "preview",
        "label": "Motion preview"
      },
      "export.completed": {
        "emit": "artifact.created",
        "artifactType": "video",
        "label": "Final master",
        "urlFrom": "sampleOutputUrl"
      },
      "run.completed": {
        "emit": "run.completed",
        "outputUrlFrom": "sampleOutputUrl"
      }
    }
  },
  "futureRunnerContract": {
    "transport": "event-stream-or-adapter-callbacks",
    "backendFramework": "none",
    "request": {
      "requiredFields": ["runId", "modeId", "prompt"],
      "optionalFields": ["attachedFiles", "platformTargets", "runSlot", "requestedAt", "researchMode"],
      "modeId": "news-character"
    },
    "events": {
      "deliveryShape": "RunEventEnvelope with a RunEvent payload",
      "order": ["run.started", "stage.*", "artifact.created", "run.completed|run.failed"],
      "stageIds": ["script", "visual-plan", "avatar", "hyperframes", "assembly", "export"],
      "progressRange": [0, 1]
    },
    "response": {
      "requiredFields": ["runId", "status", "artifacts"],
      "successFields": ["selectedTopic", "reasonItWon", "finalScript", "outputUrl"],
      "failureFields": ["blockedReason", "provider", "retryable"]
    },
    "artifactUrlPolicy": {
      "noMachineAbsolutePreviewUrls": true,
      "desktopFixtureUrlsMustComeFromPublic": true,
      "runnerArtifactUrlsMustBeAppResolvable": true
    },
    "notes": [
      "The desktop app keeps using fakeRun until this contract is wired to a real runner.",
      "A future runner should stream client-compatible RunEvent payloads and return final artifacts without requiring FastAPI or another backend framework.",
      "Provider calls are authorized by activating the mode; missing provider configuration should fail the run with a clear blocked reason."
    ]
  }
}
